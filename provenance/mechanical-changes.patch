-        Q.iquad = iquad;
-        Q.iper = iper;
-        Q.wnear = wnear;
-        Q.col_ptr = col_ptr;
-        Q.row_ind = row_ind;
-    else
-        spmat = conv_rsc_to_spmat(S,row_ptr,col_ind,wnear);
-        Q.spmat = spmat;
-    end
-    
-end
