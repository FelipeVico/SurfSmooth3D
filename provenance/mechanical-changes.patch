-        opts_qcorr = [];
-        opts_qcorr.type = 'complex';
-
-        opts_qcorr.nker = nker;
-        Q = init_empty_quadrature_correction(targinfo,opts_qcorr);
-      end
-    end
-
-    
-    rep = 'nrccie';
-
-    if isfield(opts, 'rep')
