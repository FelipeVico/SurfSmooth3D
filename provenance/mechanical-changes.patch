-        opts_quad.format = 'rsc';
-%
-%  For now Q is going to be a struct with 'quad_format', 
-%  'nkernels', 'pde', 'bc', 'kernel', 'ker_order',
-%  and either, 'wnear', 'row_ind', 'col_ptr', or
-%  with 'spmat' as a sparse matrix or a cell array of wnear/spmat
-%  if nkernel is >1
