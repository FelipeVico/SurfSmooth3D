-    for (int j = 0; j < 4; ++j) {
-      aug[i][j] = a[i][j];
-    }
-    aug[i][4] = b[i];
-  }
-  for (int c = 0; c < 4; ++c) {
-    int piv = c;
-    double pabs = std::abs(aug[c][c]);
-    for (int r = c + 1; r < 4; ++r) {
-      if (std::abs(aug[r][c]) > pabs) {
-        piv = r;
-        pabs = std::abs(aug[r][c]);
-      }
-    }
-    if (pabs < 1.0e-30 || !std::isfinite(pabs)) {
-      return false;
-    }
-    if (piv != c) {
-      for (int j = c; j < 5; ++j) {
-        std::swap(aug[c][j], aug[piv][j]);
-      }
-    }
-    const double diag = aug[c][c];
-    for (int j = c; j < 5; ++j) {
-      aug[c][j] /= diag;
-    }
-    for (int r = 0; r < 4; ++r) {
-      if (r == c) {
-        continue;
-      }
-      const double f = aug[r][c];
-      for (int j = c; j < 5; ++j) {
-        aug[r][j] -= f * aug[c][j];
-      }
-    }
-  }
-  for (int i = 0; i < 4; ++i) {
-    x[i] = aug[i][4];
-    if (!std::isfinite(x[i])) {
-      return false;
-    }
-  }
-  return true;
-}
